      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const groups = {};\nfor (const item of $input.all()) {\n  const j = item.json;\n  const subj = String(j.subject || '').replace(/^(s*(re|fwd?|fw)s*:s*)+/i, '').replace(/[‐-―−]/g, '-').replace(/s+/g, ' ').trim().toLowerCase();\n  const rawTo = String(j.sent_to || '');\n  const emails = (rawTo.match(/[A-Za-z0-9._%+'-]+@[A-Za-z0-9.-]+.[A-Za-z]{2,}/g) || [rawTo.trim()]).map((e) => e.toLowerCase()).sort().join(',');\n  const key = subj + '||' + emails;\n  if (!groups[key]) {\n    groups[key] = { ...j, times_sent: 0 };\n  }\n  groups[key].times_sent += 1;\n  if (j.date_sent > groups[key].date_sent) {\n    groups[key].date_sent = j.date_sent;\n    groups[key].resend_on = j.resend_on;\n  }\n}\nreturn Object.values(groups).map((g) => ({ json: g }));"
      },
